# Production Environment Variables - Subdomain Configuration
# Copy this to .env and fill in actual values

# Database
POSTGRES_USER=sociotools
POSTGRES_PASSWORD=ganti_dengan_password_aman_minimal_16_karakter
POSTGRES_DB=sociotools

# Redis
REDIS_PASSWORD=ganti_dengan_password_aman_minimal_16_karakter

# JWT Secrets (generate dengan: openssl rand -base64 32)
# HARUS minimal 32 karakter!
JWT_SECRET=ganti_dengan_secret_minimal_32_karakter_untuk_jwt_access_token
JWT_REFRESH_SECRET=ganti_dengan_secret_minimal_32_karakter_untuk_jwt_refresh_token

# Encryption Key (HARUS tepat 32 karakter untuk AES-256)
ENCRYPTION_KEY=ganti_dengan_32_karakter_tepat_

# URLs - Subdomain Configuration
FRONTEND_URL=https://socio.digimarket.co.id
BACKEND_URL=https://api.socio.digimarket.co.id

# Tripay Payment Gateway
# Daftar di: https://tripay.co.id
TRIPAY_API_KEY=your_tripay_api_key_here
TRIPAY_PRIVATE_KEY=your_tripay_private_key_here
TRIPAY_MERCHANT_CODE=your_merchant_code_here
TRIPAY_BASE_URL=https://tripay.co.id/api

# Xendit Payment Gateway
# Daftar di: https://dashboard.xendit.co
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_verification_token_here

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CATATAN PENTING:
# 1. Jangan gunakan password default!
# 2. Generate JWT secrets dengan: openssl rand -base64 32
# 3. Encryption key HARUS tepat 32 karakter
# 4. Simpan file .env ini dengan aman, jangan commit ke git
# 5. Backup file .env ini di tempat aman
