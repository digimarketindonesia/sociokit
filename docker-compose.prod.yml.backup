version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    container_name: sociotools-postgres
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-sociotools}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-sociotools}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backups:/backups
    networks:
      - sociotools-network
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U ${POSTGRES_USER:-sociotools}']
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: sociotools-redis
    restart: always
    command: redis-server --requirepass ${REDIS_PASSWORD} --appendonly yes
    volumes:
      - redis_data:/data
    networks:
      - sociotools-network
    healthcheck:
      test: ['CMD', 'redis-cli', '--raw', 'incr', 'ping']
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: sociotools-backend
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      NODE_ENV: production
      PORT: 3001
      DATABASE_URL: postgresql://${POSTGRES_USER:-sociotools}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-sociotools}
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      JWT_SECRET: ${JWT_SECRET}
      JWT_REFRESH_SECRET: ${JWT_REFRESH_SECRET}
      ENCRYPTION_KEY: ${ENCRYPTION_KEY}
      FRONTEND_URL: ${FRONTEND_URL}
      TRIPAY_API_KEY: ${TRIPAY_API_KEY}
      TRIPAY_PRIVATE_KEY: ${TRIPAY_PRIVATE_KEY}
      TRIPAY_MERCHANT_CODE: ${TRIPAY_MERCHANT_CODE}
      TRIPAY_BASE_URL: ${TRIPAY_BASE_URL:-https://tripay.co.id/api}
      XENDIT_SECRET_KEY: ${XENDIT_SECRET_KEY}
      XENDIT_WEBHOOK_TOKEN: ${XENDIT_WEBHOOK_TOKEN}
    volumes:
      - ./backend/uploads:/app/uploads
    ports:
      - '3001:3001'
    networks:
      - sociotools-network

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        NEXT_PUBLIC_API_URL: ${BACKEND_URL}
    container_name: sociotools-frontend
    restart: always
    depends_on:
      - backend
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_URL: ${BACKEND_URL}
    ports:
      - '3000:3000'
    networks:
      - sociotools-network

  nginx:
    image: nginx:alpine
    container_name: sociotools-nginx
    restart: always
    depends_on:
      - backend
      - frontend
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./certbot/conf:/etc/letsencrypt:ro
      - ./certbot/www:/var/www/certbot:ro
    ports:
      - '80:80'
      - '443:443'
    networks:
      - sociotools-network

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local

networks:
  sociotools-network:
    driver: bridge
